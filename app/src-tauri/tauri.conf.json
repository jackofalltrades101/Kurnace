{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kurnace",
  "version": "0.0.1",
  "identifier": "dev.kurnace.app",
  "build": {
    "devUrl": "http://localhost:1420/kurnace.html",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "Kurnace",
      "width": 1400,
      "height": 900,
      "minWidth": 960,
      "minHeight": 640,
      "resizable": true
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "category": "Video",
    "shortDescription": "Build videos with AI agents on one shared timeline",
    "longDescription": "Kurnace is a local video workspace where people and AI agents edit the same timeline, board and asset library.",
    "copyright": "© 2026 Gubran Dormoush",
    "macOS": { "minimumSystemVersion": "13.0" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.png"]
  }
}
